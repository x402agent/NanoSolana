# ═══════════════════════════════════════════════════════════════
#  MawdAxe Configuration
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Required: Your Bitaxe ───
# Single device:
BITAXE_IP=192.168.1.42
# Multiple devices (comma-separated):
# MAWDAXE_DEVICES=192.168.1.42,192.168.1.43,192.168.1.44

# ─── Mining Pool ───
POOL_URL=public-pool.io
POOL_PORT=21496
POOL_USER=YOUR_BTC_ADDRESS
POOL_PASS=x

# ─── API Server ───
MAWDAXE_API_PORT=8420
MAWDAXE_API_HOST=0.0.0.0
MAWDAXE_API_KEY=          # Leave empty for dev, set for production

# ─── Alerts (optional) ───
# Discord webhook:
# MAWDAXE_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK
# Alert cooldown in seconds:
MAWDAXE_ALERT_COOLDOWN=300

# ─── Supabase (optional, for fleet dashboard) ───
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key

# ─── Tailscale / OpenClaw Mesh (optional) ───
TAILSCALE_ENABLED=false
# TAILSCALE_AUTH_KEY=tskey-auth-xxx

# ─── Monitoring (optional) ───
# GRAFANA_PASSWORD=mawdaxe
