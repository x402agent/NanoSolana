FROM node:22-slim
WORKDIR /app

# Copy package files
COPY nano-core/package*.json ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

# Copy source
COPY nano-core/src ./src
COPY nano-core/tsconfig.json ./

# Build
RUN npx tsc --noEmit false --outDir dist 2>/dev/null || echo "Using tsx runtime"

# Run with tsx (handles TypeScript directly)
RUN npm install -g tsx

EXPOSE 3456
ENV PORT=3456
CMD ["tsx", "src/hub/registry-server.ts"]
