{
  "name": "nanosolana",
  "version": "1.0.0",
  "description": "NanoSolana × MawdBot — Unified Web3 agent runtime with containerized AI execution, OODA trading loop, PumpFun swarm, and Solana-native intelligence",
  "keywords": [
    "solana",
    "trading",
    "agent",
    "ai",
    "defi",
    "nano"
  ],
  "license": "MIT",
  "author": "NanoSolana Labs",
  "homepage": "https://nanosolana.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x402agent/NanoSolana.git",
    "directory": "nano-core"
  },
  "bugs": {
    "url": "https://github.com/x402agent/NanoSolana/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "nanosolana": "dist/cli/entry.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./sdk": "./dist/sdk/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/entry.ts",
    "build": "tsup src/index.ts src/cli/entry.ts --format esm --dts --sourcemap --out-dir dist --clean",
    "start": "node dist/cli/entry.js",
    "install:one-shot": "bash scripts/install-cli.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --write",
    "gateway": "tsx src/gateway/server.ts",
    "hub:dev": "cd ../nanohub && bun run dev",
    "nanosolana": "tsx src/cli/entry.ts",
    "claw": "tsx src/claw/index.ts",
    "claw:dev": "tsx watch src/claw/index.ts",
    "swarm": "tsx src/claw/pump/main.ts",
    "auth": "tsx src/claw/whatsapp-auth.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "^3.3.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^11.8.1",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.36.0",
    "eventemitter3": "^5.0.0",
    "express": "^5.2.1",
    "hono": "^4.12.7",
    "nanoid": "^5.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tweetnacl": "^1.0.3",
    "undici": "^7.22.0",
    "unicode-animations": "^1.0.3",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "oxfmt": "0.38.0",
    "oxlint": "^1.53.0",
    "prettier": "^3.8.1",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}