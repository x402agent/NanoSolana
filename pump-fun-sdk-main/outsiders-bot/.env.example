# ── Outsiders Bot — .env.example ──────────────────────────────────
# Copy to .env and fill in values.

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Optional: Forward calls to a dedicated channel (numeric ID)
# CALL_CHANNEL_ID=-1001234567890

# Optional: DexScreener API base
DEXSCREENER_API=https://api.dexscreener.com

# Optional: ATH polling interval in seconds
ATH_POLL_INTERVAL=60

# Optional: Log level
LOG_LEVEL=info

# Optional: SQLite database path
DB_PATH=./outsiders.db
