# ── PumpFun Channel Bot — .env.example ────────────────────────────
# Copy to .env and fill in values.

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Required: Telegram channel to post to (@channelname or -100xxx)
CHANNEL_ID=@your_channel_name

# Solana RPC
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Comma-separated fallback RPCs (rotates on 429/5xx/timeout)
# SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Affiliate ref codes for trading links
AXIOM_REF=your_axiom_ref
GMGN_REF=your_gmgn_ref
PADRE_REF=your_padre_ref

# Optional enrichment APIs
# GITHUB_TOKEN=ghp_your_github_pat
# GROQ_API_KEY=gsk_your_groq_api_key
# X_AUTH_TOKEN=your_auth_token_cookie
# X_CT0_TOKEN=your_ct0_cookie

# Feed toggles
FEED_CLAIMS=true
FEED_LAUNCHES=true
FEED_GRADUATIONS=true
FEED_WHALES=true
FEED_FEE_DISTRIBUTIONS=true

# Tuning
POLL_INTERVAL_SECONDS=30
WHALE_THRESHOLD_SOL=10
LOG_LEVEL=info
REQUIRE_GITHUB=true
