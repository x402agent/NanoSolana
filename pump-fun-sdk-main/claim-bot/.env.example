# ── PumpFun Claim Bot — .env.example ───────────────────────────────
# Copy to .env and fill in values.

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Required: Either RELAY_WS_URL or SOLANA_RPC_URL
# Direct RPC monitoring (recommended with paid RPC like Helius)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# WebSocket URL for real-time monitoring (derived from RPC if not set)
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# OR: WebSocket relay mode
# RELAY_WS_URL=ws://your-relay-server:3003

# Polling interval in seconds (used when WebSocket is unavailable)
POLL_INTERVAL_SECONDS=15

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Twitter/X API (optional — enables follower count & influencer tracking)
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# TWITTER_INFLUENCER_IDS=44196397,783214
