{
  "name": "@nanoclawd/synology-chat",
  "version": "2026.3.11",
  "description": "Synology Chat channel plugin for NanoClawd",
  "type": "module",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "nanoclawd": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "synology-chat",
      "label": "Synology Chat",
      "selectionLabel": "Synology Chat (Webhook)",
      "docsPath": "/channels/synology-chat",
      "docsLabel": "synology-chat",
      "blurb": "Connect your Synology NAS Chat to NanoClawd with full agent capabilities.",
      "order": 90
    },
    "install": {
      "npmSpec": "@nanoclawd/synology-chat",
      "localPath": "extensions/synology-chat",
      "defaultChoice": "npm"
    }
  }
}
